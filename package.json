{
  "name": "codex-ex-codespacese2606",
  "version": "1.0.0",
  "description": "Express REST API example",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node --dns-result-order=ipv4first server.js",
    "client": "vite --config client/vite.config.js --host 0.0.0.0",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build --config client/vite.config.js",
    "check": "npm run build && npm run smoke",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
