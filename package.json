    "express": "^4.22.2",
    "firebase": "^12.14.0",
    "lucide-react": "^1.17.0",
    "mongodb": "^7.2.0",
    "multer": "^2.1.1",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.17",
    "vite": "^8.0.16"
  },
